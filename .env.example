# Royal Drive Mechanics (RDM) Environment Variables

# Shop Notification Email (defaults to royaldrivemechanics@gmail.com if unset)
SHOP_NOTIFY_EMAIL=royaldrivemechanics@gmail.com

# Resend API Key for transactional booking confirmation emails
RESEND_API_KEY=re_123456789_abcdefg

# Cloudflare Turnstile Spam Protection
# Use Cloudflare test key for local development: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Environment (development | production)
ENVIRONMENT=development
