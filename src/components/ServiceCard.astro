---
import type { ServiceDetail } from '../data/services';
import { getServiceImages } from '../lib/servicesImagesLoader';

interface Props {
  service: ServiceDetail;
  showFullDetails?: boolean;
}

const { service, showFullDetails = false } = Astro.props;
const imagesResult = getServiceImages(service.slug, service.name);
const hasCover = imagesResult.hasCover;
const coverSrc = imagesResult.coverImage?.src;
const coverAlt = imagesResult.coverImage?.alt || `${service.name} at Royal Drive Mechanics, Mississauga`;
---

<article
  id={service.slug}
  class="group bg-brand-surface border border-brand-border hover:border-brand-red rounded-card overflow-hidden transition-all duration-300 flex flex-col justify-between hover:shadow-glow-red"
>
  <div>
    <!-- Thumbnail Image or Branded Placeholder -->
    <div class="relative aspect-[16/9] w-full overflow-hidden bg-brand-charcoal border-b border-brand-border">
      {hasCover ? (
        <img
          src={coverSrc}
          alt={coverAlt}
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <!-- Branded Placeholder: Dark card, red accent, icon, "Photos coming soon" -->
        <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center relative bg-gradient-to-br from-brand-charcoal via-brand-surface to-brand-charcoal">
          <!-- Subtle red diagonal stripe -->
          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
            <div class="bg-brand-red w-32 h-3 transform rotate-45 translate-x-3 -translate-y-6"></div>
          </div>
          
          <div class="w-12 h-12 rounded-full bg-brand-black/80 border border-brand-red/40 flex items-center justify-center text-xl mb-2 text-brand-red">
            ⚙️
          </div>
          <span class="text-xs font-semibold text-white tracking-wide uppercase">
            {service.shortName}
          </span>
          <span class="text-[11px] text-brand-grey/80 mt-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-red animate-pulse"></span>
            Photos coming soon
          </span>
        </div>
      )}

      <!-- Service Category Pill -->
      <span class="absolute top-3 left-3 bg-brand-black/90 backdrop-blur-sm text-[11px] uppercase tracking-wider text-white font-semibold px-2.5 py-1 rounded border border-brand-border/60">
        RDM Service
      </span>
    </div>

    <!-- Content Area -->
    <div class="p-6">
      <h3 class="text-xl font-display font-bold text-white group-hover:text-brand-red transition-colors">
        {service.name}
      </h3>
      <p class="text-xs font-semibold text-brand-red mt-1 uppercase tracking-wider">
        {service.leadTagline}
      </p>
      <p class="text-xs sm:text-sm text-brand-grey mt-3 leading-relaxed">
        {service.shortDescription}
      </p>

      <!-- What's included preview -->
      <div class="mt-4 pt-4 border-t border-brand-border/60">
        <span class="text-[11px] font-bold uppercase tracking-wider text-white block mb-2">
          Key Service Highlights:
        </span>
        <ul class="space-y-1.5 text-xs text-brand-grey">
          {service.whatsIncluded.slice(0, 3).map((item) => (
            <li class="flex items-start gap-2">
              <span class="text-brand-red font-bold mt-0.5">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Card Action Footer -->
  <div class="p-6 pt-0 flex flex-col gap-2.5">
    <a
      href={`/book?service=${encodeURIComponent(service.name)}`}
      class="w-full py-2.5 px-4 rounded-card bg-brand-red hover:bg-brand-red-hover text-white text-xs font-bold uppercase tracking-wider text-center transition shadow-glow-red"
    >
      Request a quote or book a slot
    </a>
    <a
      href={`/services/${service.slug}`}
      class="w-full py-2 px-4 rounded-card bg-brand-charcoal hover:bg-brand-border border border-brand-border text-brand-grey hover:text-white text-xs font-semibold text-center transition"
    >
      Learn more details & signs →
    </a>
  </div>
</article>
