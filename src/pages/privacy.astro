---
import BaseLayout from '../layouts/BaseLayout.astro';
import { businessConfig } from '../config/business';
import { seoData } from '../data/seo';

export const prerender = true;

const seo = seoData.privacy;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonicalPath}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Privacy Policy', url: '/privacy' }
  ]}
>
  <section class="py-16 sm:py-24 bg-brand-black border-b border-brand-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="border-b border-brand-border pb-8 mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-red">
          Canadian Privacy Compliance (PIPEDA)
        </span>
        <h1 class="text-3xl sm:text-4xl font-display font-extrabold text-white uppercase tracking-tight mt-1">
          Privacy Policy
        </h1>
        <p class="text-xs text-brand-grey mt-2">
          Effective Date: January 1, 2026 · Last Updated: October 2026
        </p>
      </div>

      <div class="prose prose-invert max-w-none text-sm text-brand-grey space-y-8 leading-relaxed">
        
        <div>
          <h2 class="text-lg font-bold text-white uppercase tracking-tight mb-3">
            1. Overview & Commitment
          </h2>
          <p>
            Royal Drive Mechanics ("RDM", "we", "us", or "our") is dedicated to protecting the privacy and personal information of our clients in Mississauga, Ontario, and surrounding communities. This Privacy Policy outlines our standards under the Canadian <em>Personal Information Protection and Electronic Documents Act</em> (PIPEDA) regarding how we collect, use, store, and safeguard your details when you use our website at <a href="https://royaldrivemechanics.ca" class="text-brand-red underline">https://royaldrivemechanics.ca</a> or reserve an automotive service slot.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-white uppercase tracking-tight mb-3">
            2. What Information We Collect
          </h2>
          <p>
            We strictly limit data collection to what is necessary to manage your workshop appointment and vehicle repair order:
          </p>
          <ul class="list-disc pl-5 space-y-1 mt-2">
            <li><strong>Contact Information:</strong> Your full name, telephone number, and email address.</li>
            <li><strong>Vehicle Details:</strong> Year, make, model, and optional notes describing mechanical symptoms or accident damage.</li>
            <li><strong>Insurance Status:</strong> Whether you are booking in relation to an auto collision or insurance claim.</li>
            <li><strong>Technical Connection Data:</strong> IP address and submission timestamp (used strictly for Cloudflare Turnstile bot deterrence and server rate-limiting).</li>
          </ul>
        </div>

        <div>
          <h2 class="text-lg font-bold text-white uppercase tracking-tight mb-3">
            3. Purpose of Collection
          </h2>
          <p>
            Your information is used solely to:
          </p>
          <ul class="list-disc pl-5 space-y-1 mt-2">
            <li>Coordinate and confirm your workshop bay appointment.</li>
            <li>Send you transactional confirmation emails and calendar files (.ics).</li>
            <li>Notify our technicians (Mirshad and team) of your scheduled arrival and vehicle requirements.</li>
            <li>Contact you regarding updates, written repair estimates, or parts availability.</li>
          </ul>
          <p class="mt-2 font-medium text-white">
            We do NOT sell, lease, or distribute your personal details to third-party advertisers or data brokers under any circumstances.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-white uppercase tracking-tight mb-3">
            4. Service Providers & Data Processing
          </h2>
          <p>
            We rely on trusted enterprise infrastructure providers to operate our booking platform:
          </p>
          <ul class="list-disc pl-5 space-y-1 mt-2">
            <li><strong>Cloudflare:</strong> Provides server edge hosting, Cloudflare D1 encrypted database storage, and Turnstile spam deterrence.</li>
            <li><strong>Resend:</strong> Dispatches transactional booking confirmation emails from <code class="text-white bg-brand-surface px-1.5 py-0.5 rounded">bookings@royaldrivemechanics.ca</code>.</li>
          </ul>
        </div>

        <div>
          <h2 class="text-lg font-bold text-white uppercase tracking-tight mb-3">
            5. Data Retention & Cleanup (12 Months)
          </h2>
          <p>
            In adherence to PIPEDA data minimization standards, all appointment records and associated customer vehicle details are automatically deleted or anonymized <strong>12 months</strong> following the date of your scheduled slot.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-white uppercase tracking-tight mb-3">
            6. Cookies & Tracking Technologies
          </h2>
          <p>
            Our website uses <strong>no invasive tracking cookies</strong> and no cross-site advertising trackers. External interactive elements such as Google Maps only load when explicitly requested by you.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-white uppercase tracking-tight mb-3">
            7. Your Rights & Deletion Requests
          </h2>
          <p>
            Under Canadian privacy law, you have the right to access the personal information we hold about you and request its correction or immediate deletion. To submit a privacy inquiry or request deletion of your booking record, please contact us directly:
          </p>
          <div class="mt-3 p-4 bg-brand-surface rounded-card border border-brand-border">
            <p class="text-white font-semibold">{businessConfig.name}</p>
            <p>Attention: Privacy Officer (Mirshad)</p>
            <p>Unit 6, 2630 Royal Windsor Drive, Mississauga, ON L5J 1K7</p>
            <p>Email: <a href="mailto:royaldrivemechanics@gmail.com" class="text-brand-red underline">royaldrivemechanics@gmail.com</a></p>
            <p>Phone: <a href="tel:+13655242003" class="text-brand-red underline">365-524-2003</a></p>
          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
